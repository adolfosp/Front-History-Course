{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Angular + Servidor (desenvolvimento)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start-all:dev",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Servidor da API (Electron)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/index.ts",
      "cwd": "${workspaceFolder}/server",
      "runtimeArgs": ["-r", "ts-node/register"],
      "envFile": "${workspaceFolder}/server/.env.production",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Electron",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/electron/main.js",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Testes Angular",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ],
  "compounds": [
    {
      "name": "Electron + Servidor",
      "configurations": ["Servidor da API (Electron)", "Electron"],
      "stopAll": true
    }
  ]
}
